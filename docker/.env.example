# Puertos locales (Apache hace TLS y proxy a estos puertos).
WEB_BIND=127.0.0.1
WEB_PORT=3016
PB_BIND=127.0.0.1
PB_PORT=18098

PB_VERSION=0.40.4
# Superusuario interno que usará la API de v2.
PB_ADMIN_EMAIL=admin@helpdesk-v2.local
PB_ADMIN_PASSWORD=change-me-min-10-chars

# API
PUBLIC_URL=https://support.example.com
JWT_ISSUER=helpdesk-v2
# Clave Ed25519 para firmar los JWT (PEM PKCS8 en base64, una sola línea):
#   openssl genpkey -algorithm ed25519 | base64 -w0
JWT_PRIVATE_KEY=
COOKIE_SECURE=true
LOG_LEVEL=info

# Correo saliente (avisos). Sin MAIL_API_KEY ni SMTP_PASSWORD no se envía nada: los avisos quedan como "skipped".
# Opción 1 (en uso): API de correo de Zoho. Pega la clave completa, con el prefijo, entre comillas:
#   MAIL_API_KEY="Zoho-enczapikey ..."
# El remitente es el predeterminado de la base (soporte@seraphsystems.com); su dominio debe estar verificado en Zoho.
MAIL_API_KEY=
# Vacío = https://cpaas.zoho.com/v1.1/email
MAIL_API_URL=
# Opción 2: SMTP (solo si no hay MAIL_API_KEY). Vacíos = los del remitente por defecto de la base.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
