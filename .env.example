# Copy to .env and adjust. Never commit real secrets.
#
# Local:
#   docker compose up --build
# Producción (erpsys / support.erpsys.pro):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#   Ver docs/DEPLOY_ERPSYS.md

PB_ADMIN_EMAIL=admin@helpdesk.local
PB_ADMIN_PASSWORD=helpdesk-admin-change-me

# Host port for the Helpdesk UI (container listens on 8080 inside).
API_PORT=3000
PB_PORT=8090

# Producción: bind solo localhost (Apache hace el proxy público).
# Local: puedes omitirlos o usar 0.0.0.0
API_BIND=127.0.0.1
PB_BIND=127.0.0.1

# Obligatorio en prod (docker-compose.prod.yml lo exige).
SESSION_SECRET=change-me-to-a-long-random-string

# URL pública de la app (enlaces en los correos).
PUBLIC_URL=https://support.erpsys.pro

# Notificaciones de implementación por correo (creación de ticket y etapas).
# Sin SMTP_HOST no se envía nada. Puerto 587 = STARTTLS, 465 = TLS implícito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=soporte@erpsys.pro
SMTP_PASSWORD=
SMTP_FROM=soporte@erpsys.pro
SMTP_FROM_NAME=Soporte ERPSYS
# Copia oculta opcional de cada aviso (separados por coma).
SMTP_BCC=
